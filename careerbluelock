    toggle(P, "Auto Skip UI", "autoSkip")
    toggle(P, "Skip Goal Anim", "skipGoalAnim")
    toggle(P, "Skip Cutscenes", "skipCutscenes")

    selectTab("HOME")

    -- INPUT LOOP
    track(UIS.InputBegan:Connect(function(input, gp)
        if binding then binding(input) return end
        if gp then return end
        if input.KeyCode == cfg.keyToggleUI then
            win.Visible = not win.Visible
        elseif input.KeyCode == cfg.keyTake then
            takeBall()
        elseif input.KeyCode == cfg.keyScore then
            scoreNow()
        end
    end))

    local nextScan = 0
    track(RunService.Heartbeat:Connect(function()
        local live = state.sim and not state.sim.outcome and os.clock() - state.lastStep < 1
        if live and cfg.infStamina then
            local found = next(state.staminas) ~= nil
            if (state.newSim or not found) and os.clock() >= nextScan then
                state.newSim = false nextScan = os.clock() + 3 findStaminas()
            end
            for t in pairs(state.staminas) do t.value = t.max end
        end
    end))

    function state.unload()
        state.alive = false
        for cls, orig in pairs(state.patched) do for k, fn in pairs(orig) do cls[k] = fn end end
        state.patched = {}
        for t, origSpend in pairs(state.staminas) do t.spend = origSpend end
        state.staminas = {}
        for _, c in ipairs(state.conns) do pcall(function() c:Disconnect() end) end
        state.conns = {}
        if state.gui then state.gui:Destroy() end
        if _G.BLBall == state then _G.BLBall = nil end
    end
    return { physicsBridge = state.bridges, matchSim = #classes, playerMotion = #motions, firesignal = firesignal ~= nil, getconnections = getconnections ~= nil }
end)(...)
