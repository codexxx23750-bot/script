			local LABEL = "Start auto weapon"
			startBtn = button(P, LABEL, "primary", function()
				if running then stop = true return end
				running, stop = true, false
				startBtn.Text = "Stop auto weapon"
				local ok, err = pcall(run)
				if not ok then info.Text = "Error: " .. tostring(err) end
				running = false
				startBtn.Text = LABEL
			end)
			local autoWpnBtn = button(P, "AUTO MAX WEAPON", "primary", function()
				pick.target = #targets
				tb.Text = "Target rarity: " .. targets[pick.target]
				if not running then
					running, stop = true, false
					startBtn.Text = "Stop auto weapon"
					task.spawn(function()
						local ok, err = pcall(run)
						if not ok then info.Text = "Error: " .. tostring(err) end
						running = false
						startBtn.Text = LABEL
					end)
				end
			end)
			info = note(P, "Idle. Select a target and press start.")
		else
			note(P, "Weapon roller data not found.", T.danger)
		end
	end
	section(P, "SKIP REROLL PASS")
	do
		local ok, EgoClient = pcall(function() return require(RS:FindFirstChild("EgoClient")) end)
		local ok2, EgoShared = pcall(function() return require(RS:FindFirstChild("EgoShared")) end)
		if ok and ok2 and EgoClient and EgoShared then
			local PASS = EgoShared.skipRerollPass
			local origCached, origOwns = EgoClient.passCached, EgoClient.ownsPass
			EgoClient.passCached = function(id, ...)
				if id == PASS and cfg.skipRoll then return true end
				return origCached(id, ...)
			end
			EgoClient.ownsPass = function(id, ...)
				if id == PASS and cfg.skipRoll then return true end
				return origOwns(id, ...)
			end
			state.restoreSkip = function()
				EgoClient.passCached, EgoClient.ownsPass = origCached, origOwns
			end
			toggle(P, "Skip reroll pass", "skipRoll")
			toggle(P, "Auto skip", "autoSkip")
			note(P, "Skip reroll pass bypasses the client-side check for the reroll gamepass. Auto skip will automatically click 'Skip' on the reward screen if the pass is active (or bypassed).")
			local pressed = setmetatable({}, { __mode = "k" })
			local nextLook = 0
			track(RunService.Heartbeat:Connect(function()
				if not (cfg.autoSkip and cfg.skipRoll) or os.clock() < nextLook then return end
				nextLook = os.clock() + 0.15
				local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
				if not pg then return end
				for _, b in ipairs(pg:GetDescendants()) do
					if b:IsA("TextButton") and b.Text == "Skip" and b.Visible and not pressed[b] then
						pressed[b] = true
						task.delay(0.5, function() pressed[b] = nil end)
						if firesignal then
							pcall(firesignal, b.MouseButton1Click)
						elseif getconnections then
							for _, c in ipairs(getconnections(b.MouseButton1Click)) do pcall(c.Fire, c) end
						end
					end
				end
			end))
		else
			note(P, "Skip data not found.", T.danger)
		end
	end
end)

pcall(function()
	local P = pages["FARM"]
	section(P, "FARM MODES")
	do
		local ok, EgoClient = pcall(function() return require(RS:FindFirstChild("EgoClient")) end)
		local ok2, EgoShared = pcall(function() return require(RS:FindFirstChild("EgoShared")) end)
		local ok3, GauntletData = pcall(function() return require(RS:FindFirstChild("GauntletData")) end)
		if ok and ok2 and ok3 and EgoClient and EgoShared and GauntletData then
			local lastCall = 0
			local function call(...)
				local r
				for _ = 1, 6 do
					local wait = lastCall + 1.5 - os.clock()
					if wait > 0 then task.wait(wait) end
					local ok, res = pcall(EgoClient.call, ...)
					lastCall = os.clock()
					r = ok and type(res) == "table" and res or { status = ok and "error" or tostring(res) }
					if r.status ~= "busy" then break end
					task.wait(2)
				end
				return r
			end
			local function coins()
				local p = EgoClient.profile()
				return p and tonumber(p.egoCoins) or 0
			end
			local function hold(job, secs)
				local untilT = os.clock() + secs
				while os.clock() < untilT do
					if job.stop or not state.alive then return false end
					task.wait(0.25)
				end
				return true
			end
			local function report(job, verb, ...)
				local r = call(verb, "match", true, ...)
				if r.status == "cooldown" and tonumber(r.wait) then
					if not hold(job, tonumber(r.wait) + 0.5) then return r end
					r = call(verb, "match", true, ...)
				end
				return r
			end
			local function farmButton(label, idleText, run)
				local job = { running = false, stop = false }
				local btn, info
				btn = button(P, label, "primary", function()
					if job.running then
						job.stop = true
						btn.Text = "STOPPING"
						return
					end
					job.running, job.stop = true, false
					btn.Text = label .. " (RUNNING)"
					task.spawn(function()
						local ok, err = pcall(run, job, function(t) info.Text = t end)
						if not ok then info.Text = "Error: " .. tostring(err) end
						job.running = false
						btn.Text = label
					end)
				end)
				info = note(P, idleText)
				return job
			end
			state.gauJob = farmButton("Auto Gauntlet", "Farming Gauntlet...", function(job, say)
				local cfgG = EgoShared.gauntlet
				local startCoins, matches, clears = coins(), 0, 0
				local saved
				while not job.stop and state.alive do
					local st = call("gauntlet", "get")
					local run = st.run
					if st.status ~= "ok" then
						say("Error fetching gauntlet state: " .. tostring(st.status) .. ". Retrying...")
						if not hold(job, 5) then break end
					elseif type(run) ~= "table" then
						if not saved then
							say("No saved lineup. Please enter a gauntlet match manually first.")
							return
						end
						local s = call("gauntlet", "load", saved.slot, saved.lineup, saved.spot)
						say("Restoring saved lineup: " .. tostring(s.status))
						if s.status ~= "loaded" and s.status ~= "wait" then
							say("Failed to restore lineup: " .. tostring(s.status) .. ". Stopping.")
							return
						end
					else
						local lineup = {}
						for k, v in pairs(run.lineup or {}) do lineup[tostring(k)] = v end
						saved = { slot = tonumber(run.slotKey), lineup = lineup, spot = run.playerSpot }
						local stage = tonumber(run.stage) or 1
						local team = GauntletData.teams[stage]
						local name = team and team.name
						local b = call("gauntlet", "start", name)
						if b.status ~= "ok" and not run.inMatch then
							say("Stage " .. stage .. " start failed: " .. tostring(b.status) .. ". Retrying...")
							if not hold(job, 4) then break end
						else
							say(string.format("Stage %d (%d/%d matches). Team: %s. Coins gained: %d", stage, cfgG.matches or 15, tostring(name), coins() - startCoins))
							if not hold(job, (cfgG.minSeconds or 30) + 1) then break end
							local r = report(job, "gauntlet", 2, 0, 8.4, name, cfgG.firstTo or 3, 0)
							if r.status == "won" then
								matches = matches + 1
								say(string.format("Stage %d won! Matches: %d. Coins gained: %d", stage, matches, coins() - startCoins))
							elseif r.status == "cleared" then
								matches, clears = matches + 1, clears + 1
								say(string.format("Gauntlet CLEARED! Won: %d coins. Total clears: %d. Coins gained: %d. Total coins: %d", tostring(r.coins), clears, coins() - startCoins, coins()))
							elseif r.status == "failed" then
								say("Stage " .. stage .. " failed. Retrying...")
							else
								say("Stage " .. stage .. " error: " .. tostring(r.status) .. ". Retrying...")
								if not hold(job, 3) then break end
							end
						end
					end
				end
				say(string.format("Farming stopped. Matches: %d, Clears: %d, Coins gained: %d", matches, clears, coins() - startCoins))
			end)
		else
			note(P, "Farm data not found.", T.danger)
		end
	end
	section(P, "MISC")
	toggle(P, "Anti-AFK", "antiAfk")
	track(LocalPlayer.Idled:Connect(function()
		if not cfg.antiAfk then return end
		pcall(function()
			local vu = game:GetService("VirtualUser")
			vu:CaptureController()
			vu:ClickButton2(Vector2.new())
		end)
	end))
	note(P, "Anti-AFK prevents the game from kicking you for being idle.")
end)

