    local function slider(page, label, key, min, max, step, fmt)
        local row = new("Frame", { Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = T.panel, LayoutOrder = nextOrder(), ZIndex = 12 }, page)
        corner(row) stroke(row)
        new("TextLabel", { Size = UDim2.new(1, -90, 0, 20), Position = UDim2.fromOffset(12, 5), BackgroundTransparency = 1, Text = label, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13 }, row)
        
        local val = new("TextLabel", { Size = UDim2.fromOffset(76, 20), Position = UDim2.new(1, -88, 0, 5), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.accent, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 13 }, row)
        local bar = new("TextButton", { Size = UDim2.new(1, -24, 0, 4), Position = UDim2.fromOffset(12, 33), BackgroundColor3 = T.off, AutoButtonColor = false, Text = "", ZIndex = 13 }, row)
        corner(bar, 2)
        local fill = new("Frame", { BackgroundColor3 = T.accent, BorderSizePixel = 0, ZIndex = 14 }, bar)
        corner(fill, 2)
        local knob = new("Frame", { Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1,1,1), ZIndex = 15 }, bar)
        corner(knob, 6) stroke(knob, T.accent)
        
        local function set(v)
            v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)
            cfg[key] = v
            local a = (v - min) / (max - min)
            fill.Size = UDim2.fromScale(a, 1)
            knob.Position = UDim2.fromScale(a, 0.5)
            val.Text = string.format(fmt, v)
        end
        local dragging = false
        local function fromX(x) set(min + math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1) * (max - min)) end
        bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true fromX(i.Position.X) end end)
        track(UIS.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end end))
        track(UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end end))
        set(cfg[key])
    end

