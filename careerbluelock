return (function(...)
    if _G.BLBall and _G.BLBall.unload then
        pcall(_G.BLBall.unload)
    end
    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local RunService = game:GetService("RunService")
    local RS = game:GetService("ReplicatedStorage")
    local LocalPlayer = Players.LocalPlayer
    
    local cfg = {
        magnet = false, magnetRange = 30, magnetPower = 0.6, reach = 1, tackle = 1,
        unstealable = false, speed = 1, shotPower = 1, infStamina = false,
        autoGreen = false, autoTrain = false, autoBond = false, noCooldown = false,
        instaGoal = false, autoHundred = false, hundredTime = 20.2, rigFlow = false,
        antiAfk = true, skipRoll = true, autoSkip = false, skipGoalAnim = false, skipCutscenes = false,
    }
    local state = { alive = true, sim = nil, myBody = nil, lastStep = 0, conns = {}, patched = {}, staminas = setmetatable({}, { __mode = "k" }) }
    _G.BLBall = state
    local function track(c)
        state.conns[#state.conns + 1] = c
        return c
    end
    local function controlledOf(sim)
        for _, p in ipairs(sim.players or {}) do
            if p.controlled then
                return p
            end
        end
    end
    
    function state.putInGoal(sim, p)
        local goal = sim:goalOf(p.side)
        local sign = goal.X >= 0 and 1 or -1
        local ball = sim.ball
        sim.lastTouch = p
        if sim.shot then sim.shot.saved = nil end
        ball.position = Vector3.new(goal.X + sign * 2, sim.physics.radius + 0.5, 0)
        ball.velocity = Vector3.new(sign * 25, 0, 0)
        ball.spin = Vector3.new(0, 0, 0)
    end
    
    local classes, motions, seen = {}, {}, {}
    local function hasFns(t, a, b, c)
        local ok, yes = pcall(function()
            return type(rawget(t, a)) == "function" and type(rawget(t, b)) == "function" and type(rawget(t, c)) == "function"
        end)
        return ok and yes
    end
    local function addClass(t)
        if type(t) ~= "table" or seen[t] then return end
        if hasFns(t, "controlRadius", "interceptRadius", "tackleRadius") then
            seen[t] = true
            classes[#classes + 1] = t
        elseif hasFns(t, "step", "getSpeed", "getAcceleration") then
            seen[t] = true
            motions[#motions + 1] = t
        end
    end
    do
        local engine = RS:WaitForChild("Engine")
        for _, name in ipairs({ "MatchSim", "PlayerMotion" }) do
            local ok, mod = pcall(function()
                return require(engine:WaitForChild(name))
            end)
            if ok then addClass(mod) end
        end
        if getgc then
            for _, v in ipairs(getgc(true)) do
                addClass(v)
            end
        end
    end
    local function patchMotion(cls)
        local orig = { step = rawget(cls, "step") }
        state.patched[cls] = orig
        cls.step = function(self, body, ...)
            if body ~= state.myBody then
                return orig.step(self, body, ...)
            end
            if cfg.infStamina then body.fatigue = 0 end
            local s = cfg.speed
            if s == 1 then
                return orig.step(self, body, ...)
            end
            local sprint, jog, accel = body.sprint, body.jog, body.acceleration
            body.sprint, body.jog, body.acceleration = sprint * s, jog * s, accel * s
            local ok, a, b = pcall(orig.step, self, body, ...)
            body.sprint, body.jog, body.acceleration = sprint, jog, accel
            if not ok then error(a, 0) end
            return a, b
        end
    end
    local function patch(cls)
        local orig = {}
        for _, k in ipairs({ "controlRadius", "interceptRadius", "tackleRadius", "resolveTackle", "shoot", "magnet" }) do
            orig[k] = rawget(cls, k)
        end
        state.patched[cls] = orig
        cls.controlRadius = function(self, p, ...)
            local r = orig.controlRadius(self, p, ...)
            if p and p.controlled then r = r * cfg.reach end
            return r
        end
        cls.interceptRadius = function(self, p, ...)
            local r = orig.interceptRadius(self, p, ...)
            if p and p.controlled then r = r * cfg.reach end
            return r
        end
        cls.tackleRadius = function(self, p, ...)
            local r = orig.tackleRadius(self, p, ...)
            if p and p.controlled then r = r * cfg.tackle end
            return r
        end
        cls.resolveTackle = function(self, tackler, victim, ...)
            if cfg.unstealable and victim and victim.controlled and tackler and not tackler.controlled then
                if tackler.keeper then return false end
                victim.ai.immuneUntil = math.max(victim.ai.immuneUntil or 0, self.clock + 0.5)
            end
            return orig.resolveTackle(self, tackler, victim, ...)
        end
        cls.shoot = function(self, p, target, charge, ...)
            if p and p.controlled and cfg.shotPower ~= 1 then
                -- CORRIGIDO: Usando a variável real p.stats.shotPower
                local base = charge or (0.65 + math.max(0, ((p.stats and p.stats.shotPower) or 60) / 250) * 0.35)
                charge = base * cfg.shotPower
            end
            local a, b = orig.shoot(self, p, target, charge, ...)
            if cfg.instaGoal and p and p.controlled then
                state.putInGoal(self, p)
            end
            return a, b
        end
        cls.magnet = function(self, dt, ...)
            if state.sim ~= self then state.newSim = true end
            state.sim = self
            state.lastStep = os.clock()
            local me = controlledOf(self)
            state.myBody = me and me.body or nil
            orig.magnet(self, dt, ...)
            if not cfg.magnet or self.possession then return end
            if not me then return end
            if (me.ai.noTouchUntil or 0) > self.clock then return end
            if self.shot and not self.shot.resolved then return end
            if self.pass and self.pass.from == me and self.clock - (self.pass.time or 0) < 1.5 then return end
            local ball = self.ball
            local d = me.body.position - ball.position
            local flat = Vector3.new(d.X, 0, d.Z)
            local dist = flat.Magnitude
            if dist > cfg.magnetRange or dist < 0.5 then return end
            local vel = Vector3.new(ball.velocity.X, 0, ball.velocity.Z)
            local want = flat.Unit * math.max(vel.Magnitude, 22)
            local v = vel:Lerp(want, math.min(1, dt * cfg.magnetPower * 8))
            ball.velocity = Vector3.new(v.X, ball.velocity.Y, v.Z)
        end
    end
    for _, cls in ipairs(classes) do
        patch(cls)
    end
    for _, cls in ipairs(motions) do
        patchMotion(cls)
    end
    state.bridges = 0
    do
        local bseen = {}
        local function patchBridge(cls)
            if type(cls) ~= "table" or bseen[cls] then return end
            if not hasFns(cls, "celebrate", "shotCutscene", "credit") then return end
            bseen[cls] = true
            state.bridges = state.bridges + 1
            local orig = { celebrate = rawget(cls, "celebrate"), shotCutscene = rawget(cls, "shotCutscene"), credit = rawget(cls, "credit") }
            state.patched[cls] = orig
            cls.celebrate = function(self, ...)
                if cfg.skipGoalAnim then return end
                return orig.celebrate(self, ...)
            end
            cls.shotCutscene = function(self, ...)
                if cfg.skipCutscenes then return false end
                return orig.shotCutscene(self, ...)
            end
            cls.credit = function(self, ...)
                local r = orig.credit(self, ...)
                if cfg.skipGoalAnim then
                    pcall(function() LocalPlayer:SetAttribute("isCelebrating", 0) end)
                end
                return r
            end
        end
        local ok, mod = pcall(function()
            return require(RS:WaitForChild("Engine"):WaitForChild("Bridge", 5))
        end)
        if ok then patchBridge(mod) end
        if getgc then
            for _, v in ipairs(getgc(true)) do
                if type(v) == "table" then patchBridge(v) end
            end
        end
    end
    local function findStaminas()
        if not getgc then return end
        for _, t in ipairs(getgc(true)) do
            if type(t) == "table" and not state.staminas[t] then
                local ok, yes = pcall(function()
                    return type(rawget(t, "spend")) == "function"
                        and type(rawget(t, "value")) == "number"
                        and type(rawget(t, "max")) == "number"
                end)
                if ok and yes then
                    local origSpend = rawget(t, "spend")
                    state.staminas[t] = origSpend
                    t.spend = function(...)
                        if cfg.infStamina then return end
                        return origSpend(...)
                    end
                end
            end
        end
    end
    local function takeBall()
        local sim = state.sim
        if not sim or sim.outcome or os.clock() - state.lastStep > 1 then
            return false, "Simulation not running"
        end
        local me = controlledOf(sim)
        if not me then return false, "Player not found" end
        sim.physics:kick(sim.ball, Vector3.new(0, 0, 0), Vector3.new(0, 0, 0))
        sim.ball.position = me.body.position + me.body.facing * 1.2 + Vector3.new(0, sim.physics.radius, 0)
        sim.ball.spin = Vector3.new(0, 0, 0)
        sim.pass = nil
        sim:takePossession(me)
        me.ai.immuneUntil = math.max(me.ai.immuneUntil or 0, sim.clock + 0.8)
        return true
    end
    local function scoreNow()
        local sim = state.sim
        if not sim or sim.outcome or os.clock() - state.lastStep > 1 then
            return false, "Simulation not running"
        end
        local me = controlledOf(sim)
        if not me then return false, "Player not found" end
        if sim.possession then sim:releaseBall(sim.possession) end
        sim.pass = nil
        state.putInGoal(sim, me)
        return true
    end
    local function pressButton(btn)
        if firesignal and pcall(firesignal, btn.Activated) then
            return true
        end
        if getconnections then
            local ok, conns = pcall(getconnections, btn.Activated)
            if ok and conns and #conns > 0 then
                for _, c in ipairs(conns) do
                    pcall(function() c:Fire() end)
                end
                return true
            end
        end
        return false
    end
    local function strike(btn)
        if pressButton(btn) then return end
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.delay(0.03, function()
            vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
    end
    local function playerGui()
        return LocalPlayer:FindFirstChildOfClass("PlayerGui")
    end
    local function trainingParts(sg)
        for _, d in ipairs(sg:GetDescendants()) do
            if d:IsA("Frame") and d.ClipsDescendants then
                local zone, line
                for _, c in ipairs(d:GetChildren()) do
                    if c:IsA("Frame") then
                        if c.Size.X.Offset == 6 and c.AnchorPoint == Vector2.new(0.5, 0.5) then
                            line = c
                        elseif c.Size.Y.Scale == 1 and c.Size.X.Scale > 0 then
                            zone = c
                        end
                    end
                end
                if zone and line then
                    return zone, line, sg:FindFirstChildWhichIsA("TextButton", true)
                end
            end
        end
    end
    local tr = { sg = nil, lastX = nil, pressedAt = 0, continued = false }
    track(RunService.RenderStepped:Connect(function()
        if not cfg.autoGreen then return end
        local pg = playerGui()
        local sg = pg and pg:FindFirstChild("TrainingMinigame")
        if not sg then
            tr.sg = nil
            return
        end
        if tr.sg ~= sg then
            tr.sg = sg
            tr.zone, tr.line, tr.btn = trainingParts(sg)
            tr.lastX, tr.continued = nil, false
        end
        if not (tr.zone and tr.btn) then return end
        if tr.btn.Text == "Continue" then
            if not tr.continued then
                tr.continued = true
                local btn = tr.btn
                task.delay(0.8, function()
                    if btn.Parent then pressButton(btn) end
                end)
            end
            return
        end
        local x = tr.line.Position.X.Scale
        local last = tr.lastX
        tr.lastX = x
        if last == nil or last == x or os.clock() - tr.pressedAt < 0.5 then return end
        local z0, w = tr.zone.Position.X.Scale, tr.zone.Size.X.Scale
        local centre = z0 + w / 2
        local d = math.abs(x - centre)
        local inZone = x >= z0 and x <= z0 + w
        if d <= w * 0.15 or (inZone and d > math.abs(last - centre)) then
            tr.pressedAt = os.clock()
            strike(tr.btn)
        end
    end))
    task.spawn(function()
        while state.alive do
            task.wait(1)
            local pg = playerGui()
            if pg and (cfg.autoTrain or cfg.autoBond) and not pg:FindFirstChild("TrainingMinigame") then
                local trainBtn
                for _, b in ipairs(pg:GetDescendants()) do
                    if b:IsA("TextButton") and b.Visible then
                        if cfg.autoBond and b.Text:match("Bond") then
                            pressButton(b)
                        elseif cfg.autoTrain and not trainBtn and b.Text == "Train" then
                            trainBtn = b
                        end
                    end
                end
                if trainBtn then
                    pressButton(trainBtn)
                    task.wait(1)
                end
            end
        end
    end)
    do
        local ok, Chem = pcall(function()
            return require(RS:WaitForChild("Chemistry"))
        end)
        if ok and type(Chem) == "table" and type(Chem.cooldownLeft) == "function" then
            local origCooldown = Chem.cooldownLeft
            Chem.cooldownLeft = function(data, who, kind, ...)
                if cfg.noCooldown and (kind == "flow" or kind == "style") then
                    return 0
                end
                return origCooldown(data, who, kind, ...)
            end
            state.patched[Chem] = { cooldownLeft = origCooldown }
        end
    end

    --════════════════════════════════════════════════════════════════
    -- UI SETUP (KOTA HUB)
    --════════════════════════════════════════════════════════════════
