    section(P, "HUNDRED CHALLENGE")
    do
        local hc = require(RS:WaitForChild("EgoShared")).hundredChallenge
        local OVERHEAD = 0.5
        local function finishAt() return math.max(1, cfg.hundredTime - OVERHEAD) end
        local run = { t0 = nil, lastSeen = 0, fired = setmetatable({}, { __mode = "k" }) }
        local function hit(btn)
            if firesignal then pcall(firesignal, btn.MouseButton1Down)
            elseif getconnections then for _, c in ipairs(getconnections(btn.MouseButton1Down)) do pcall(function() c:Fire() end) end end
        end
        local function scan(frame)
            local goals, target = nil, nil
            for _, d in ipairs(frame:GetDescendants()) do
                if d:IsA("TextLabel") then
                    local n = tonumber(string.match(d.Text, "(%d+)"))
                    if n and (not goals or n > goals) then goals = n end
                elseif d:IsA("TextButton") and d.Text == "" and not run.fired[d] then
                    local p = d.Parent
                    local c = p and p:IsA("Frame") and p:FindFirstChildOfClass("UICorner")
                    if c and p:FindFirstChildOfClass("UIStroke")
                        and (c.CornerRadius.Offset >= 30 or c.CornerRadius.Scale >= 0.5)
                        and p.AbsoluteSize.X > 0 and p.AbsoluteSize.X < 300 then
                        target = d
                    end
                end
            end
            return goals, target
        end
        toggle(P, "Auto Finish Hundred", "autoHundred")
        slider(P, "Time per Goal", "hundredTime", hc.minTime - 1, hc.minTime + 3, 0.1, "%.1fs")
        
        track(RunService.Heartbeat:Connect(function()
            if not cfg.autoHundred then return end
            local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            local frame = pg and pg:FindFirstChild("HundredChallenge", true)
            if not frame then run.t0 = nil return end
            local goals, target = scan(frame)
            local now = os.clock()
            if not target then if run.t0 and now - run.lastSeen > 3 then run.t0 = nil end return end
            run.lastSeen = now goals = goals or 0
            local finish = finishAt()
            if not run.t0 or goals == 0 and now - run.t0 > finish then run.t0 = now end
            if now >= run.t0 + (goals + 1) * finish / hc.goals then run.fired[target] = true hit(target) end
