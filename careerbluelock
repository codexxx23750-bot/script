        bg = Color3.fromRGB(14, 14, 18),
        panel = Color3.fromRGB(22, 22, 30),
        panelHi = Color3.fromRGB(32, 32, 44),
        accent = Color3.fromRGB(139, 92, 246),
        text = Color3.fromRGB(240, 240, 245),
        dim = Color3.fromRGB(150, 150, 160),
        muted = Color3.fromRGB(100, 100, 110),
        stroke = Color3.fromRGB(40, 40, 52),
        off = Color3.fromRGB(40, 40, 50),
    }
    local QUICK = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local TweenService = game:GetService("TweenService")

    local function new(class, props, parent)
        local i = Instance.new(class)
        for k, v in pairs(props) do i[k] = v end
        if parent then i.Parent = parent end
        return i
    end
    local function corner(p, r) new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, p) end
    local function stroke(p, c) return new("UIStroke", { Color = c or T.stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p) end

    pcall(function()
        for _, gui in pairs(game:GetService("CoreGui"):GetChildren()) do if gui.Name:find("KotaHub") then gui:Destroy() end end
        if LocalPlayer:FindFirstChild("PlayerGui") then
            for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do if gui.Name:find("KotaHub") then gui:Destroy() end end
        end
    end)

    local sg = new("ScreenGui", { Name = "KotaHub_V5", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999 }, nil)
    local okParent = pcall(function() sg.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
    if not okParent then sg.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    state.gui = sg

    local W, H = 480, 360
    local win = new("Frame", { Size = UDim2.fromOffset(W, H), Position = UDim2.fromOffset(40, 40), BackgroundColor3 = T.bg, BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 10 }, sg)
    corner(win, 12) stroke(win, T.stroke)

    local topBar = new("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, Active = true, ZIndex = 11 }, win)
    local title = new("TextLabel", { Size = UDim2.fromOffset(200, 50), Position = UDim2.fromOffset(16, 0), BackgroundTransparency = 1, Text = "KOTA HUB", Font = Enum.Font.GothamBlack, TextSize = 20, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12 }, topBar)
    new("UIGradient", { Color = ColorSequence.new(T.accent, Color3.fromRGB(200, 200, 255)) }, title)

    local closeBtn = new("TextButton", { Size = UDim2.fromOffset(30, 30), Position = UDim2.new(1, -40, 0.5, -15), BackgroundColor3 = T.panel, Text = "×", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = T.dim, AutoButtonColor = false, ZIndex = 12 }, topBar)
    corner(closeBtn, 8)
    closeBtn.MouseButton1Click:Connect(function() sg:Destroy() state.alive = false end)

    local minBtn = new("TextButton", { Size = UDim2.fromOffset(30, 30), Position = UDim2.new(1, -76, 0.5, -15), BackgroundColor3 = T.panel, Text = "—", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = T.dim, AutoButtonColor = false, ZIndex = 12 }, topBar)
    corner(minBtn, 8)
    
    local tabBar = new("Frame", { Size = UDim2.new(1, -32, 0, 32), Position = UDim2.fromOffset(16, 56), BackgroundColor3 = T.panel, ZIndex = 11 }, win)
    corner(tabBar, 8)
    new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, tabBar)
    new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, tabBar)

    local pages, tabs = {}, {}
    local TAB_NAMES = { "MATCH", "TRAINING", "CAREER", "FARM" }
    local currentTab = "MATCH"

    local function selectTab(name)
        currentTab = name
        for n, t in pairs(tabs) do
            local on = n == name
            t.btn.BackgroundColor3 = on and T.accent or T.panel
            t.btn.TextColor3 = on and Color3.new(1,1,1) or T.dim
            if pages[n] then pages[n].Visible = on end
        end
    end

    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            TweenService:Create(win, QUICK, { Size = UDim2.fromOffset(W, 50) }):Play()
            tabBar.Visible = false
            for _, p in pairs(pages) do p.Visible = false end
        else
            TweenService:Create(win, QUICK, { Size = UDim2.fromOffset(W, H) }):Play()
            tabBar.Visible = true
            selectTab(currentTab)
        end
    end)

    local dragStart, startPos
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragStart, startPos = input.Position, win.Position end
    end)
    track(UIS.InputChanged:Connect(function(input)
        if dragStart and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            win.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    track(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragStart = nil end
    end))

    for i, name in ipairs(TAB_NAMES) do
        local b = new("TextButton", { Size = UDim2.new(1/#TAB_NAMES, -3, 1, 0), BackgroundColor3 = T.panel, AutoButtonColor = false, Text = name, Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = T.dim, LayoutOrder = i, ZIndex = 12 }, tabBar)
        corner(b, 6)
        tabs[name] = { btn = b }
        
        local page = new("ScrollingFrame", { Size = UDim2.new(1, -32, 0, H - 116), Position = UDim2.fromOffset(16, 96), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 11 }, win)
        new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, page)
        new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, page)
        
        pages[name] = page
        b.MouseButton1Click:Connect(function() selectTab(name) end)
    end

    -- FLOATING BUTTONS INDEPENDENTES
    local function makeDraggableBtn(label, callback, defaultPos)
        local b = new("TextButton", {
            Size = UDim2.fromOffset(100, 36),
            Position = defaultPos,
            BackgroundColor3 = T.bg,
            Text = label,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = T.text,
            AutoButtonColor = false,
            Active = true,
            ZIndex = 1000
        }, sg)

        corner(b, 8)
        stroke(b, T.accent)

        local dragging = false
        local dragInput, dragStart, startPos
        local moved = false

        b.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                moved = false
                dragStart = input.Position
                startPos = b.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)

        b.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
        end)

        track(UIS.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then moved = true end
                b.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end))

        b.MouseButton1Click:Connect(function()
            if moved then return end
            TweenService:Create(b, QUICK, { BackgroundColor3 = T.accent }):Play()
            task.delay(0.1, function() TweenService:Create(b, QUICK, { BackgroundColor3 = T.bg }):Play() end)
            callback()
        end)
        return b
    end

    local floatTake = makeDraggableBtn("Take Ball [G]", function() takeBall() end, UDim2.new(1, -120, 0.5, -24))
    local floatScore = makeDraggableBtn("Score [H]", function() scoreNow() end, UDim2.new(1, -120, 0.5, 20))

    -- UI COMPONENTS
    local order = 0
    local function nextOrder() order = order + 1 return order end

    local function section(page, text)
        new("TextLabel", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamBlack, TextSize = 11, TextColor3 = T.accent, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = nextOrder(), ZIndex = 12 }, page)
    end

    local function toggle(page, label, key)
        local row = new("TextButton", { Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.panel, AutoButtonColor = false, Text = "", LayoutOrder = nextOrder(), ZIndex = 12 }, page)
        corner(row) stroke(row)
        new("TextLabel", { Size = UDim2.new(1, -60, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1, Text = label, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13 }, row)
        
        local rail = new("Frame", { Size = UDim2.fromOffset(36, 18), Position = UDim2.new(1, -48, 0.5, -9), BackgroundColor3 = cfg[key] and T.accent or T.off, ZIndex = 13 }, row)
        corner(rail, 9)
        local knob = new("Frame", { Size = UDim2.fromOffset(14, 14), Position = cfg[key] and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2), BackgroundColor3 = cfg[key] and Color3.new(1,1,1) or T.dim, ZIndex = 14 }, rail)
        corner(knob, 7)
        
        row.MouseButton1Click:Connect(function()
