        end))
        note(P, "Prevents the game from kicking you for being idle for 20 minutes.")
        
        section(P, "CLAIM REWARDS")
        local claimBtn, claimInfo
        claimBtn = button(P, "CLAIM DAILY + ACHIEVEMENTS", false, function()
            claimBtn.Text = "CLAIMING..."
            task.spawn(function()
                local before = coins()
                local AS = require(LocalPlayer.PlayerScripts:WaitForChild("AutoSave"):WaitForChild("AutoSave"))
                local slot = AS.get()
                local d = call("daily")
                local a = call("claimAchievements", slot)
                claimInfo.Text = ("Daily: %s | Achievements: %s | Coins gained: %d"):format(tostring(d.status), tostring(a.status), coins() - before)
                claimBtn.Text = "CLAIM DAILY + ACHIEVEMENTS"
            end)
        end)
        claimInfo = note(P, "Claim daily and achievement rewards directly via server call.")
    end

    selectTab("MATCH")

    -- INPUT LOOP
    track(UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            win.Visible = not win.Visible
        elseif input.KeyCode == Enum.KeyCode.G then
            takeBall()
        elseif input.KeyCode == Enum.KeyCode.H then
            scoreNow()
        end
    end))

    local nextScan = 0
    track(RunService.Heartbeat:Connect(function()
        local live = state.sim and not state.sim.outcome and os.clock() - state.lastStep < 1
        if live and cfg.infStamina then
            local found = next(state.staminas) ~= nil
            if (state.newSim or not found) and os.clock() >= nextScan then
                state.newSim = false
                nextScan = os.clock() + 3
                findStaminas()
            end
            for t in pairs(state.staminas) do
                t.value = t.max
            end
        end
    end))

    function state.unload()
        if state.restoreSkip then pcall(state.restoreSkip) end
        if state.infJob then state.infJob.stop = true end
        if state.gauJob then state.gauJob.stop = true end
        state.alive = false
        for cls, orig in pairs(state.patched) do
            for k, fn in pairs(orig) do
                cls[k] = fn
            end
        end
        state.patched = {}
        for t, origSpend in pairs(state.staminas) do
            t.spend = origSpend
        end
        state.staminas = {}
        for _, c in ipairs(state.conns) do
            pcall(function() c:Disconnect() end)
        end
        state.conns = {}
        if state.gui then state.gui:Destroy() end
        if _G.BLBall == state then _G.BLBall = nil end
    end
    return { physicsBridge = state.bridges, matchSim = #classes, playerMotion = #motions, firesignal = firesignal ~= nil, getconnections = getconnections ~= nil }
end)(...)
